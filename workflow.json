{
  "project": {
    "name": "npx ng serve --proxy-config proxy.conf.json",
    "description": "A scalable marketplace where clients browse products and sellers manage their own catalog and images using a microservices architecture.",
    "goal": "Learn and apply real-world backend architecture using Spring Boot microservices, JWT authentication, and MongoDB.",
    "architecture": "Microservices (User, Product, Media, Gateway)",
    "communication": "REST APIs (HTTP)",
    "database": "MongoDB per service except Gateway and media (media via local storage or cloud)",
    "security": "JWT Authentication via Gateway",
    "optional": ["Kafka (events)", "Docker", "Eureka Discovery"]
  },

  "team": {
    "members": [
      {
        "name": "Ali",
        "role": "Backend Developer",
        "responsibility": "User Service + Authentication"
      },
      {
        "name": "Adnan",
        "role": "Backend Developer",
        "responsibility": "Product Service"
      }
    ],
    "collaboration_rules": [
      "Each developer works on their own microservice",
      "Do not modify other services without discussion",
      "Communicate API contracts clearly",
      "Test endpoints before integration"
    ]
  },

  "services": {
    "user-service": {
      "owner": "Ali",
      "port": 8081,
      "responsibilities": [
        "User registration (CLIENT | SELLER)",
        "User login",
        "Password hashing (BCrypt)",
        "JWT token generation",
        "User profile management"
      ],
      "endpoints": [
        "POST /auth/register",
        "POST /auth/login",
        "GET /me",
        "PUT /me"
      ],
      "database": "userdb",
      "notes": [
        "This is the core authentication service",
        "All passwords must be encrypted",
        "Never expose sensitive data"
      ]
    },

    "product-service": {
      "owner": "Adnan",
      "port": 8082,
      "responsibilities": [
        "Create products",
        "Update products",
        "Delete products",
        "List all products (public)",
        "Link images to products"
      ],
      "rules": [
        "Only SELLER can create/update/delete",
        "Seller can only manage their own products"
      ],
      "endpoints": [
        "GET /products",
        "GET /products/{id}",
        "POST /products",
        "PUT /products/{id}",
        "DELETE /products/{id}"
      ],
      "database": "productdb",
      "model_example": {
        "id": "string",
        "name": "string",
        "description": "string",
        "price": "number",
        "quantity": "number",
        "userId": "string",
        "imageUrls": ["string"]
      }
    },

    "media-service": {
      "owner": "Shared",
      "port": 8083,
      "responsibilities": [
        "Upload images",
        "Validate image type (image/*)",
        "Enforce max size (2MB)",
        "Serve images"
      ],
      "endpoints": [
        "POST /media/images",
        "GET /media/images/{id}",
        "DELETE /media/images/{id}"
      ],
      "rules": [
        "Only SELLER can upload images",
        "File must be image",
        "Max size = 2MB"
      ]
    },

    "gateway-service": {
      "owner": "Shared",
      "port": 8080,
      "responsibilities": [
        "Route requests to services",
        "Validate JWT",
        "Handle CORS",
        "Forward user info (userId, role)"
      ],
      "routes": {
        "/auth/**": "user-service",
        "/products/**": "product-service",
        "/media/**": "media-service"
      }
    }
  },

  "workflow": {
    "step_1": "Ali builds User Service (register + login + JWT)",
    "step_2": "Adnan builds Product Service (CRUD + seller ownership)",
    "step_3": "Build Media Service (image upload + validation)",
    "step_4": "Integrate Gateway (routing + security)",
    "step_5": "Connect everything together"
  },

  "request_flow_example": {
    "login": [
      "Client sends credentials to /auth/login",
      "User Service validates and returns JWT"
    ],
    "create_product": [
      "Client sends request with JWT",
      "Gateway validates JWT",
      "Gateway forwards request with user info",
      "Product Service checks role and ownership",
      "Product is saved in database"
    ]
  },

  "rules": {
    "do": [
      "Keep services independent",
      "Use clean code structure",
      "Test APIs with Postman",
      "Commit regularly"
    ],
    "dont": [
      "Do not share databases between services",
      "Do not skip validation",
      "Do not trust frontend data"
    ]
  },

  "final_goal": "A working backend where sellers can manage products and images securely, and clients can browse products through a scalable microservices system."
}